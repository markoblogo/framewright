{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental studio source, fact and edit intake",
  "type": "object",
  "required": [
    "scenario",
    "sources"
  ],
  "properties": {
    "scenario": {
      "enum": [
        "repackaging",
        "insight",
        "hybrid"
      ]
    },
    "intended_use": {
      "enum": [
        "private-test",
        "noncommercial",
        "commercial"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "origin"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "video",
              "audio",
              "image",
              "text",
              "reference"
            ]
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rights": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "unknown",
                  "granted",
                  "noncommercial_only",
                  "denied"
                ]
              },
              "evidence": {
                "type": "string"
              }
            }
          },
          "video_rights": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "unknown",
                  "granted",
                  "noncommercial_only",
                  "denied"
                ]
              },
              "evidence": {
                "type": "string"
              }
            }
          },
          "audio_rights": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "unknown",
                  "granted",
                  "noncommercial_only",
                  "denied"
                ]
              },
              "evidence": {
                "type": "string"
              }
            }
          },
          "audio_policy": {
            "enum": [
              "remove",
              "replace",
              "keep"
            ]
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "text",
          "locator"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "review": {
            "enum": [
              "pending",
              "verified",
              "rejected"
            ]
          }
        }
      }
    },
    "edits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "in_seconds",
          "out_seconds",
          "reason"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "in_seconds": {
            "type": "number",
            "minimum": 0
          },
          "out_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "wall_minutes": {
          "type": "number",
          "minimum": 0
        },
        "max_input_seconds": {
          "type": "number",
          "minimum": 0
        },
        "max_output_seconds": {
          "type": "number",
          "minimum": 0
        },
        "max_work_mb": {
          "type": "number",
          "minimum": 0
        },
        "max_download_mb": {
          "type": "number",
          "minimum": 0
        },
        "paid_calls": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "brief": {
      "type": "object"
    }
  },
  "description": "workflow.py checks referenced IDs and intervals plus scenario requirements. Missing facts/caps produce blockers; this schema does not qualify tools or media."
}
