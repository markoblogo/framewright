{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SSI weekly video input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant",
    "report_id",
    "report_snapshot_sha256",
    "source_manifest_sha256",
    "report_period",
    "delivery_date",
    "report_language",
    "video_language",
    "template_sha256",
    "parts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tenant": {
      "const": "ssi"
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "report_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "report_period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "label"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "delivery_date": {
      "type": "string",
      "format": "date"
    },
    "report_language": {
      "const": "uk"
    },
    "video_language": {
      "const": "en"
    },
    "template_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "report_part_sha256",
          "scenes",
          "include_site_ending"
        ],
        "properties": {
          "id": {
            "enum": [
              "logistics",
              "grains",
              "oilseeds"
            ]
          },
          "report_part_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "scenes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "headline_en",
                "hero",
                "chart",
                "takeaway_en",
                "narration_en",
                "claim_ids"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "headline_en": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 90
                },
                "hero": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "display",
                    "value",
                    "unit",
                    "basis",
                    "source_period",
                    "claim_ids"
                  ],
                  "properties": {
                    "display": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "number"
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    },
                    "basis": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_period": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "start",
                        "end",
                        "label"
                      ],
                      "properties": {
                        "start": {
                          "type": "string",
                          "format": "date"
                        },
                        "end": {
                          "type": "string",
                          "format": "date"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "claim_ids": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "chart": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "label",
                    "rows"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "rows",
                        "bars",
                        "share",
                        "none"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "label",
                          "value",
                          "unit",
                          "basis",
                          "source_period",
                          "claim_ids"
                        ],
                        "properties": {
                          "label": {
                            "type": "string",
                            "minLength": 1
                          },
                          "value": {
                            "type": "number"
                          },
                          "unit": {
                            "type": "string",
                            "minLength": 1
                          },
                          "basis": {
                            "type": "string",
                            "minLength": 1
                          },
                          "source_period": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "start",
                              "end",
                              "label"
                            ],
                            "properties": {
                              "start": {
                                "type": "string",
                                "format": "date"
                              },
                              "end": {
                                "type": "string",
                                "format": "date"
                              },
                              "label": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          },
                          "claim_ids": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "takeaway_en": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                },
                "narration_en": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                },
                "claim_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "include_site_ending": {
            "type": "boolean"
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "id": {
                "const": "logistics"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "grains"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "oilseeds"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  }
}
