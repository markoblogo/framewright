{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Framewright experiment records",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/record"
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "local_output",
        "sha256",
        "bytes"
      ],
      "properties": {
        "local_output": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "thumbnail": {
      "type": "object",
      "required": [
        "local_output",
        "sha256",
        "bytes",
        "format",
        "width",
        "height"
      ],
      "properties": {
        "local_output": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "const": "png"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "record": {
      "type": "object",
      "required": [
        "local_output",
        "sha256",
        "bytes",
        "id",
        "route",
        "evidence",
        "qa_scope"
      ],
      "properties": {
        "local_output": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "qa_scope": {
          "type": "string",
          "minLength": 1
        },
        "native_export": {
          "$ref": "#/$defs/artifact"
        },
        "thumbnail": {
          "$ref": "#/$defs/thumbnail"
        },
        "evidence_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
